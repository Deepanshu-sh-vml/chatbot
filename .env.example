# Copy this file to .env and fill in your API key

# Current LLM Configuration (GEMINI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://api.gemini.com/v1
GEMINI_MODEL=gemini-2.5-flash

# ADK Configuration (for Agent Development Kit integration)
ADK_MODEL=gemini-2.5-flash
ADK_TEMPERATURE=0.3
ADK_MAX_TOKENS=3000
ADK_BASE_URL=https://api.gemini.com/v1
USE_ADK_PIPELINE=false

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000